{
  "name": "sled",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Draw a line. He rides it. Deterministic Verlet physics on ruled notebook paper.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node --experimental-strip-types --no-warnings scripts/check-determinism.mjs",
    "test": "npm run typecheck && npm run verify"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
